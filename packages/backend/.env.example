# ChromaDB Configuration
# Host address of the ChromaDB server
CHROMA_HOST=192.168.110.172

# Port number of the ChromaDB server
CHROMA_PORT=8085

# OpenAI-Compatible Embedding API Configuration
# Used for vector search to convert query text to embeddings
EMBEDDING_API_URL=http://192.168.110.172:8011/v1
EMBEDDING_API_KEY=empty
EMBEDDING_MODEL=Qwen3-VL-Embedding-2B

# === Multi-Collection Mode Configuration ===

# Enable multi-collection mode (true/false)
# When enabled, all ChromaDB collections are accessible via API
MULTI_COLLECTION_MODE=true

# Maximum number of collections to keep loaded in memory (LRU cache)
# When exceeded, least recently used collections will be unloaded
MAX_CACHED_COLLECTIONS=5

# Representative-item clustering using cosine similarity in the original vector space.
# Tune thresholds against labeled examples for the actual embedding model.
QUESTION_CLUSTER_NEAR_DUPLICATE_THRESHOLD=0.97
QUESTION_CLUSTER_SIMILARITY_THRESHOLD=0.73
QUESTION_CLUSTER_UNIQUE_WEIGHT=0.4
QUESTION_CLUSTER_REQUEST_WEIGHT=0.6
QUESTION_CLUSTER_UNIQUE_TARGET=0.8
QUESTION_CLUSTER_REQUEST_TARGET=0.901
